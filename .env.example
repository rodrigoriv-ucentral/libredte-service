# Ejemplo de configuración. Copia este archivo a .env y reemplaza TODOS los
# valores CAMBIAR_* / example por los tuyos. Nunca subas el .env real.

# Token compartido con la aplicación cliente (header Authorization: Bearer ...)
LIBREDTE_API_TOKEN=CAMBIAR_token_largo_y_aleatorio

# "certificacion" mientras se hace el proceso con el SII, "produccion" una vez aprobado
LIBREDTE_AMBIENTE=certificacion

# POST /rvd (RCOF diario): con LIBREDTE_AMBIENTE=produccion el RVD se arma pero
# NO se sube al SII salvo que esto sea "on" (el RVD no es obligatorio desde 2022-08).
LIBREDTE_RVD_PRODUCCION=off

# Resolución SII que autoriza a emitir DTE (NroResol / FchResol en el XML).
# Si se deja sin definir, el default depende de LIBREDTE_AMBIENTE:
# - certificacion: 0 / 2014-08-22
# - produccion:    80 / 2014-08-22
# Durante la certificación, fija aquí la resolución que indique el SII para tu
# set de pruebas. En producción déjalas comentadas para usar el default.
# LIBREDTE_RESOLUCION_FECHA=AAAA-MM-DD
# LIBREDTE_RESOLUCION_NUMERO=0

# Datos del emisor (tu empresa), tal como quedaron inscritos en el SII
LIBREDTE_EMISOR_RUT=12345678-5
LIBREDTE_EMISOR_RAZON_SOCIAL="Empresa de Ejemplo SpA"
LIBREDTE_EMISOR_GIRO="Giro de ejemplo"
LIBREDTE_EMISOR_ACTECO=000000
LIBREDTE_EMISOR_DIRECCION="Calle Ejemplo 123"
LIBREDTE_EMISOR_COMUNA="Comuna"
# Opcionales
# LIBREDTE_EMISOR_CIUDAD=
# LIBREDTE_EMISOR_TELEFONO=
# LIBREDTE_EMISOR_EMAIL=facturacion@example.com

# Casilla de intercambio entre contribuyentes declarada ante el SII
LIBREDTE_MAIL_INTERCAMBIO=intercambio@example.com

# Datos para transferencia impresos en la factura (opcionales; sin número no se imprimen)
# LIBREDTE_BANCO_NOMBRE=
# LIBREDTE_BANCO_TIPO_CUENTA=
# LIBREDTE_BANCO_NUMERO_CUENTA=
# LIBREDTE_BANCO_EMAIL=

# Representación impresa (PDF)
# Logo opcional: ruta DENTRO del contenedor a un PNG/JPG (p. ej. montado por volumen).
# LIBREDTE_PDF_LOGO=/data/logo.png
# URL pública de consulta de boletas que el SII exige imprimir en la boleta (39).
LIBREDTE_URL_CONSULTA_BOLETA=https://example.com/consulta-boleta

# Rutas dentro del contenedor (no cambiar salvo que muevas los volúmenes)
LIBREDTE_CERT_PATH=/data/certs/certificado.pfx
# Opcional: solo si colocas el .pfx manualmente en vez de subirlo por POST /certificado
# (que guarda la clave junto al certificado).
LIBREDTE_CERT_PASS=

# CAF (carpeta) y base de folios (SQLite): si se dejan sin definir, el default
# depende de LIBREDTE_AMBIENTE, para que certificación y producción NUNCA
# compartan CAF ni contador de folios:
# - certificacion: /data/caf             y /data/db/folios.sqlite
# - produccion:    /data/caf/produccion  y /data/db/produccion/folios.sqlite
# LIBREDTE_CAF_DIR=/data/caf/produccion
# LIBREDTE_DB_PATH=/data/db/produccion/folios.sqlite
