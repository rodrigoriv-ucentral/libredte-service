{# Factura / NC / ND. Azul SII (#000080) para emisor, etiquetas y encabezados;
   valores e ítems en negro; recuadro SII en rojo.
   Motor: mPDF → maquetar con tablas y alinear con atributos align/valign.
   Requisitos SII que NO se deben quitar: recuadro rojo con RUT, tipo y folio; "S.I.I. - <unidad>"
   bajo el recuadro; referencias del documento; timbre PDF417 abajo a la izquierda con resolución y
   "Verifique documento: www.sii.cl"; acuse de recibo y leyenda CEDIBLE en la copia cedible.
   Datos que agrega DteEmisor::prepararRender(): document_auth (resolución) y
   document_extra.cedible / cuenta_bancaria / monto_palabras / logo. #}
{% macro pesos(valor, otraMoneda) -%}
    {%- if otraMoneda -%}{{ valor | number_format(2, '.', ',') }}{%- else -%}$ {{ valor | number_format(0, ',', '.') }}{%- endif -%}
{%- endmacro %}
{% import _self as m %}
{% set enc = document.Encabezado %}
{% set otraMoneda = enc.Totales.TpoMoneda is not empty and enc.Totales.TpoMoneda == 'DOLAR USA' %}
{% set detalles = document.Detalle ?? [] %}
{# Acuse de recibo (Ley 19.983): va SOLO en la copia cedible, nunca en NC/ND; la leyenda CEDIBLE, solo si se pidió. #}
{% set cedible = document_extra.cedible ?? false %}
{% set acuse_recibo = acuse_recibo ?? cedible %}
{% set monto_palabras = document_extra.monto_palabras ?? null %}
{% set cuenta = document_extra.cuenta_bancaria ?? null %}
{% set hayCodigo = detalles | filter(d => d.CdgItem is defined and d.CdgItem is not empty and d.CdgItem.VlrCodigo is not empty) | length > 0 %}
{% set hayCantidad = detalles | filter(d => d.QtyItem is defined and d.QtyItem is not empty) | length > 0 %}
{% set hayUnidad = detalles | filter(d => d.UnmdItem is defined and d.UnmdItem is not empty) | length > 0 %}
{% set hayPrecio = detalles | filter(d => d.PrcItem is defined and d.PrcItem is not empty) | length > 0 %}
{% set hayDescuento = detalles | filter(d => (d.DescuentoMonto is defined and d.DescuentoMonto is not empty) or (d.DescuentoPct is defined and d.DescuentoPct is not empty)) | length > 0 %}
<html>
<head>
    <style>
        @page { size: 216mm 279mm; margin: 10mm 10mm 12mm 10mm; }
        body { font-family: Arial, Helvetica, sans-serif; font-size: 8.8pt; color: #000000; }
        p { margin: 0; }
        table { border-collapse: collapse; }
        .azul { color: #000080; }

        .cabecera { width: 100%; }
        .cabecera td { vertical-align: top; padding: 0; }
        .logo { width: 32mm; height: auto; }
        .emisor td { padding: 0.5mm 0; font-size: 8.3pt; color: #000080; }
        .emisor .razon { font-size: 14pt; font-weight: bold; letter-spacing: 0.3pt; padding-bottom: 1.2mm; }
        .emisor .giro { font-weight: bold; padding-bottom: 1mm; }
        .emisor .contacto { padding-top: 1mm; }

        .recuadro { width: 100%; border: 0.6mm solid #FF0000; }
        .recuadro td { text-align: center; color: #FF0000; font-weight: bold; font-size: 12.5pt; padding: 1.4mm 2mm; }
        .recuadro .primera { padding-top: 4mm; }
        .recuadro .ultima { padding-bottom: 4mm; }
        .unidad-sii { color: #FF0000; font-weight: bold; font-size: 9pt; padding-top: 2.5mm; }

        .cliente { width: 100%; border: 0.3mm solid #000080; margin-top: 4mm; }
        .cliente td { padding: 1mm 2.5mm; vertical-align: top; }
        .cliente .k { font-weight: bold; color: #000080; white-space: nowrap; width: 17%; font-size: 8pt; }
        .cliente .kd { font-weight: bold; color: #000080; white-space: nowrap; font-size: 8pt; }
        .cliente .vd { text-align: right; white-space: nowrap; }
        .cliente .pad-top td { padding-top: 2.5mm; }
        .cliente .pad-bottom td { padding-bottom: 2.5mm; }

        .detalle { width: 100%; margin-top: 5mm; }
        .detalle th { white-space: nowrap; font-weight: bold; font-size: 8pt; text-align: left; color: #000000; padding: 2mm 2.5mm; border-top: 0.3mm solid #000080; border-bottom: 0.3mm solid #000080; }
        .detalle td { padding: 2.2mm 2.5mm; vertical-align: top; }
        .detalle .num { text-align: right; white-space: nowrap; }
        .detalle .desc { font-size: 7.8pt; color: #444444; padding-top: 0.6mm; }
        .fin-detalle { border-top: 0.4mm solid #000080; margin-top: 0; }

        .nota { margin-top: 3mm; font-size: 8.5pt; }
        .nota .k { font-weight: bold; color: #000080; padding-right: 3mm; }

        .pie { position: absolute; left: 10mm; right: 10mm; bottom: 12mm; }
        .son { width: 100%; margin-bottom: 3mm; font-size: 8.3pt; }
        .son .k { font-weight: bold; color: #000080; width: 9mm; white-space: nowrap; }
        .pie-tabla { width: 100%; }
        .pie-tabla > tbody > tr > td { padding: 0; }
        .img-timbre { width: 64mm; height: 31mm; }
        .timbre-leyenda { font-size: 7.5pt; padding-top: 1mm; }

        .totales { width: 100%; border: 0.3mm solid #000080; }
        .totales td { padding: 1.3mm 4mm; white-space: nowrap; }
        .totales .k { font-weight: bold; color: #000080; font-size: 8.3pt; }
        .totales .v { text-align: right; }
        .totales .primera td { padding-top: 3mm; }
        .totales .ultima td { padding-bottom: 3mm; }
        .totales .total td { font-size: 11pt; font-weight: bold; color: #000000; border-top: 0.3mm solid #000080; }
        .totales .total .k { color: #000000; font-size: 10pt; }

        .banco { width: 100%; margin-top: 3mm; font-size: 8pt; border: 0.2mm solid #D5D8E3; }
        .banco td { padding: 0.6mm 2.5mm; }
        .banco .titulo { font-weight: bold; color: #000080; padding-top: 1.5mm; padding-bottom: 1mm; border-bottom: 0.2mm solid #D5D8E3; }
        .banco .k { color: #000080; }
        .banco .ultima td { padding-bottom: 1.5mm; }

        .acuse { width: 100%; border: 0.3mm solid #000080; margin-top: 3mm; }
        .acuse td { padding: 1.2mm 2.5mm; font-size: 8pt; }
        .acuse .titulo { font-weight: bold; color: #000080; text-align: center; border-bottom: 0.3mm solid #000080; }
        .acuse .linea { border-bottom: 0.2mm solid #000000; }
        .acuse .legal { font-size: 6.8pt; text-align: justify; }
        .cedible { font-weight: bold; font-size: 12pt; padding-top: 1.5mm; }
    </style>
</head>
<body>

{# ── Cabecera: logo · emisor · recuadro SII ── #}
<table class="cabecera">
    <tr>
        <td style="width: 17%;" valign="middle">
            {% if document_extra.logo is defined and document_extra.logo is not empty %}<img src="{{ document_extra.logo }}" alt="Logo" class="logo">{% endif %}
        </td>
        <td style="width: 46%; padding-left: 4mm;" valign="middle">
            {% set telefono = enc.Emisor.Telefono is iterable ? enc.Emisor.Telefono | join(' / ') : enc.Emisor.Telefono %}
            <table class="emisor">
                <tr><td class="razon">{{ enc.Emisor.RznSoc | default(enc.Emisor.RznSocEmisor) }}</td></tr>
                <tr><td class="giro">{{ enc.Emisor.GiroEmis | default(enc.Emisor.GiroEmisor) }}</td></tr>
                <tr><td>{{ enc.Emisor.DirOrigen }}</td></tr>
                <tr><td>{{ [enc.Emisor.CmnaOrigen | lower | title, enc.Emisor.CiudadOrigen is not empty ? enc.Emisor.CiudadOrigen | lower | title : ''] | filter(v => v is not empty) | join(', ') }}</td></tr>
                {% if enc.Emisor.CorreoEmisor is not empty %}<tr><td class="contacto">E-mail: {{ enc.Emisor.CorreoEmisor }}</td></tr>{% endif %}
                {% if telefono is not empty %}<tr><td>Teléfono: {{ telefono }}</td></tr>{% endif %}
            </table>
        </td>
        <td style="width: 37%;">
            <table class="recuadro">
                <tr><td class="primera">R.U.T.: {{ enc.Emisor.RUTEmisor | format_as('billing_document.RUTEmisor') }}</td></tr>
                <tr><td>{{ enc.IdDoc.TipoDTE | format_as('billing_document.TipoDTE') | upper }}</td></tr>
                <tr><td class="ultima">N° {{ enc.IdDoc.Folio }}</td></tr>
            </table>
            <table style="width: 100%;"><tr><td class="unidad-sii" align="center">S.I.I. - {{ enc.Emisor.CmnaOrigen | format_as('billing_document.CdgSIISucur') | upper }}</td></tr></table>
        </td>
    </tr>
</table>

{# ── Recuadro del cliente (izquierda) y fechas (derecha) ── #}
{% set filas = [] %}
{% if enc.Receptor.RznSocRecep is not empty %}{% set filas = filas | merge([['SEÑOR(ES):', enc.Receptor.RznSocRecep]]) %}{% endif %}
{% if enc.Receptor.RUTRecep != '66666666-6' %}{% set filas = filas | merge([['RUT:', enc.Receptor.RUTRecep | format_as('billing_document.RUTRecep')]]) %}{% endif %}
{% if enc.Receptor.GiroRecep is not empty %}{% set filas = filas | merge([['GIRO:', enc.Receptor.GiroRecep]]) %}{% endif %}
{% if enc.Receptor.DirRecep is not empty %}{% set filas = filas | merge([['DIRECCIÓN:', enc.Receptor.DirRecep]]) %}{% endif %}
{% if enc.Receptor.CmnaRecep is not empty %}{% set filas = filas | merge([['COMUNA:', enc.Receptor.CmnaRecep]]) %}{% endif %}
{% if enc.Receptor.CiudadRecep is not empty %}{% set filas = filas | merge([['CIUDAD:', enc.Receptor.CiudadRecep]]) %}{% endif %}
{% if enc.Receptor.CorreoRecep is not empty %}{% set filas = filas | merge([['E-MAIL:', enc.Receptor.CorreoRecep]]) %}{% endif %}
{% if enc.Receptor.Contacto is not empty %}{% set filas = filas | merge([['CONTACTO:', enc.Receptor.Contacto]]) %}{% endif %}
{% if enc.Receptor.CdgIntRecep is not empty %}{% set filas = filas | merge([['CÓD. CLIENTE:', enc.Receptor.CdgIntRecep]]) %}{% endif %}
{% if enc.Transporte is not empty and enc.Transporte.DirDest is not empty %}{% set filas = filas | merge([['DESTINO:', [enc.Transporte.DirDest, enc.Transporte.CmnaDest] | filter(v => v is not empty) | join(', ')]]) %}{% endif %}
{# Referencias: obligatorias en la representación impresa (NC/ND: documento que corrigen). #}
{% for ref in document.Referencia ?? [] %}
    {% set esSet = ref.TpoDocRef is not empty and ref.TpoDocRef == 'SET' %}
    {% set textoRef = esSet
        ? 'Set de pruebas SII: ' ~ ref.RazonRef
        : [
            (ref.TpoDocRef is not empty ? ref.TpoDocRef | format_as('billing_document.TpoDocRef') : ''),
            (ref.FolioRef is not empty and ref.IndGlobal != 1 ? 'N° ' ~ ref.FolioRef : ''),
            (ref.FchRef is not empty ? 'del ' ~ (ref.FchRef | date('d/m/Y')) : '')
          ] | filter(v => v is not empty) | join(' ') ~ (ref.RazonRef is not empty ? ' — ' ~ ref.RazonRef : '') %}
    {% set filas = filas | merge([['REFERENCIA:', textoRef]]) %}
{% endfor %}

{% set fechas = [['FECHA EMISIÓN:', enc.IdDoc.FchEmis | date('d/m/Y')]] %}
{% if enc.IdDoc.FchVenc is not empty %}{% set fechas = fechas | merge([['FECHA VENCIMIENTO:', enc.IdDoc.FchVenc | date('d/m/Y')]]) %}{% endif %}
{% if enc.IdDoc.FmaPago is not empty %}{% set fechas = fechas | merge([['FORMA DE PAGO:', enc.IdDoc.FmaPago | format_as('billing_document.FmaPago')]]) %}{% endif %}
{% if enc.IdDoc.PeriodoDesde is not empty and enc.IdDoc.PeriodoHasta is not empty %}{% set fechas = fechas | merge([['PERÍODO:', (enc.IdDoc.PeriodoDesde | date('d/m/Y')) ~ ' al ' ~ (enc.IdDoc.PeriodoHasta | date('d/m/Y'))]]) %}{% endif %}
{% if enc.Totales.TpoMoneda is not empty %}{% set fechas = fechas | merge([['MONEDA:', enc.Totales.TpoMoneda]]) %}{% endif %}

{% set nFilas = max(filas | length, fechas | length) %}
<table class="cliente">
    {% for i in 0..(nFilas - 1) %}
        {% set f = filas[i] ?? null %}
        {% set d = fechas[i] ?? null %}
        <tr class="{{ i == 0 ? 'pad-top' : '' }} {{ i == nFilas - 1 ? 'pad-bottom' : '' }}">
            <td class="k">{{ f ? f[0] : '' }}</td>
            <td style="width: 46%;">{{ f ? f[1] : '' }}</td>
            <td class="kd" style="width: 20%;">{{ d ? d[0] : '' }}</td>
            <td class="vd" style="width: 14%;">{{ d ? d[1] : '' }}</td>
        </tr>
    {% endfor %}
</table>

{# ── Detalle ── #}
{% set subtotal = 0 %}
{% set subtotalAfecto = 0 %}
<table class="detalle">
    <tr>
        {% if hayCodigo %}<th style="width: 11%;">Código</th>{% endif %}
        <th>Item</th>
        {% if hayPrecio %}<th class="num" style="width: 14%; text-align: right;">Valor Unitario</th>{% endif %}
        {% if hayCantidad %}<th class="num" style="width: 11%; text-align: right;">Cantidad</th>{% endif %}
        {% if hayUnidad %}<th style="width: 7%;">Unidad</th>{% endif %}
        {% if hayDescuento %}<th class="num" style="width: 19%; text-align: right;">Descuento</th>{% endif %}
        <th class="num" style="width: 13%; text-align: right;">Subtotal</th>
    </tr>
    {% for d in detalles %}
        <tr>
            {% if hayCodigo %}<td>{{ d.CdgItem is not empty and d.CdgItem.VlrCodigo is not empty ? d.CdgItem.VlrCodigo : '' }}</td>{% endif %}
            <td>
                {{ d.NmbItem | default('') }}{% if d.IndExe is not empty and d.IndExe == 1 %} (exento){% endif %}
                {% if d.DscItem is not empty %}<div class="desc">{{ d.DscItem }}</div>{% endif %}
            </td>
            {% if hayPrecio %}<td class="num">{{ d.PrcItem is not empty ? m.pesos(d.PrcItem, otraMoneda) : '' }}</td>{% endif %}
            {% if hayCantidad %}<td class="num">{{ d.QtyItem is not empty ? d.QtyItem | number_format(d.QtyItem == d.QtyItem | round ? 0 : 2, ',', '.') : '' }}</td>{% endif %}
            {% if hayUnidad %}<td>{{ d.UnmdItem | default('') }}</td>{% endif %}
            {% if hayDescuento %}<td class="num">{{ d.DescuentoMonto is not empty ? m.pesos(d.DescuentoMonto, otraMoneda) : '$ 0' }}{% if d.DescuentoPct is not empty %} ({{ d.DescuentoPct | number_format(0, ',', '.') }}%){% endif %}</td>{% endif %}
            <td class="num">{{ m.pesos(d.MontoItem | default(0), otraMoneda) }}</td>
        </tr>
        {% set subtotal = subtotal + (d.MontoItem | default(0)) %}
        {% if d.IndExe is empty %}{% set subtotalAfecto = subtotalAfecto + (d.MontoItem | default(0)) %}{% endif %}
    {% endfor %}
</table>
<div class="fin-detalle"></div>

{% if enc.IdDoc.TermPagoGlosa is not empty %}
    <table class="nota"><tr><td class="k" valign="top">Términos de pago:</td><td>{{ enc.IdDoc.TermPagoGlosa }}</td></tr></table>
{% endif %}

{# ── Pie: timbre (izquierda) · totales + cuenta bancaria (derecha) ── #}
<div class="pie">
    {% if monto_palabras is not empty %}
        <table class="son"><tr><td class="k" valign="top">SON:</td><td>{{ monto_palabras }}</td></tr></table>
    {% endif %}
    <table class="pie-tabla">
        <tr>
            <td style="width: 52%;" valign="bottom">
                {% if document_stamp is not empty %}
                    <table style="width: 100%;">
                        <tr><td align="center"><img class="img-timbre" src="{{ document_stamp | format_as('billing_document.TED') }}" alt="Timbre Electrónico SII"></td></tr>
                        <tr><td align="center" class="timbre-leyenda">
                            Timbre Electrónico SII<br>
                            {% if document_auth is not empty %}Res. {{ document_auth.numero_resolucion ?? document_auth.NroResol }} de {{ (document_auth.fecha_resolucion ?? document_auth.FchResol) | date('Y') }} - {% endif %}Verifique documento: www.sii.cl
                        </td></tr>
                    </table>
                {% endif %}
            </td>
            <td style="width: 8%;"></td>
            <td style="width: 40%;" valign="bottom">
                {% set lineas = [] %}
                {% if document.DscRcgGlobal is not empty %}
                    {% set lineas = lineas | merge([['SUBTOTAL ($)', m.pesos(subtotal, otraMoneda)]]) %}
                    {% for dr in document.DscRcgGlobal %}
                        {% set base = dr.IndExeDR is not empty ? (subtotal - subtotalAfecto) : subtotalAfecto %}
                        {% set montoDR = dr.TpoValor == '%' ? (base * dr.ValorDR / 100) | round : dr.ValorDR %}
                        {% set lineas = lineas | merge([[(dr.TpoMov | trim | upper == 'D' ? 'DESCUENTO' : 'RECARGO') ~ (dr.TpoValor == '%' ? ' ' ~ dr.ValorDR ~ '%' : '') ~ ' ($)', (dr.TpoMov | trim | upper == 'D' ? '- ' : '') ~ m.pesos(montoDR, otraMoneda)]]) %}
                    {% endfor %}
                {% endif %}
                {% if enc.Totales.MntNeto is not empty %}{% set lineas = lineas | merge([['NETO ($)', m.pesos(enc.Totales.MntNeto, otraMoneda)]]) %}{% endif %}
                {% if enc.Totales.MntExe is not empty %}{% set lineas = lineas | merge([['EXENTO ($)', m.pesos(enc.Totales.MntExe, otraMoneda)]]) %}{% endif %}
                {% if enc.Totales.IVA is not empty %}{% set lineas = lineas | merge([['I.V.A. ' ~ (enc.Totales.TasaIVA | default(19)) ~ '%', m.pesos(enc.Totales.IVA, otraMoneda)]]) %}{% endif %}
                {% if enc.Totales.IVANoRet is not empty %}{% set lineas = lineas | merge([['IVA NO RETENIDO', m.pesos(enc.Totales.IVANoRet, otraMoneda)]]) %}{% endif %}
                {% for imp in enc.Totales.ImptoReten ?? [] %}{% set lineas = lineas | merge([[(imp.TipoImp | format_as('billing_document.TipoImp') | upper) ~ ' ' ~ imp.TasaImp ~ '%', m.pesos(imp.MontoImp, otraMoneda)]]) %}{% endfor %}
                {% set lineas = lineas | merge([['TOTAL ($)', m.pesos(enc.Totales.MntTotal, otraMoneda)]]) %}
                {% if enc.Totales.MontoNF is not empty %}{% set lineas = lineas | merge([['NO FACTURABLE ($)', m.pesos(enc.Totales.MontoNF, otraMoneda)]]) %}{% endif %}
                {% if enc.Totales.MontoPeriodo is not empty %}{% set lineas = lineas | merge([['MONTO PERÍODO ($)', m.pesos(enc.Totales.MontoPeriodo, otraMoneda)]]) %}{% endif %}
                <table class="totales">
                    {% for l in lineas %}
                        <tr class="{{ loop.first ? 'primera' : '' }} {{ loop.last ? 'ultima' : '' }} {{ l[0] == 'TOTAL ($)' ? 'total' : '' }}">
                            <td class="k">{{ l[0] }}</td>
                            <td class="v">{{ l[1] }}</td>
                        </tr>
                    {% endfor %}
                </table>
                {% if cuenta is not empty %}
                    <table class="banco">
                        <tr><td colspan="2" class="titulo">Datos para transferencia</td></tr>
                        <tr><td class="k" style="width: 34%;">Titular</td><td>{{ enc.Emisor.RznSoc | default(enc.Emisor.RznSocEmisor) }}</td></tr>
                        <tr><td class="k">RUT</td><td>{{ enc.Emisor.RUTEmisor | format_as('billing_document.RUTEmisor') }}</td></tr>
                        {% if cuenta.banco is not empty %}<tr><td class="k">Banco</td><td>{{ cuenta.banco }}</td></tr>{% endif %}
                        {% if cuenta.tipo is not empty %}<tr><td class="k">Tipo de cuenta</td><td>{{ cuenta.tipo }}</td></tr>{% endif %}
                        <tr class="{{ cuenta.email is empty ? 'ultima' : '' }}"><td class="k">N° de cuenta</td><td>{{ cuenta.numero }}</td></tr>
                        {% if cuenta.email is not empty %}<tr class="ultima"><td class="k">E-mail</td><td>{{ cuenta.email }}</td></tr>{% endif %}
                    </table>
                {% endif %}
            </td>
        </tr>
    </table>

    {% if acuse_recibo %}
        <table class="acuse">
            <tr><td colspan="6" class="titulo">ACUSE DE RECIBO</td></tr>
            <tr>
                <td style="width: 10%; white-space: nowrap;">Nombre:</td><td class="linea" style="width: 34%;"></td>
                <td style="width: 10%; white-space: nowrap;">R.U.T.:</td><td class="linea" style="width: 16%;"></td>
                <td style="width: 9%; white-space: nowrap;">Fecha:</td><td class="linea"></td>
            </tr>
            <tr>
                <td>Recinto:</td><td class="linea"></td>
                <td>Firma:</td><td class="linea" colspan="3"></td>
            </tr>
            <tr><td colspan="6" class="legal">El acuse de recibo que se declara en este acto, de acuerdo a lo dispuesto en la letra b) del Art. 4°, y la letra c) del Art. 5° de la Ley 19.983, acredita que la entrega de mercaderías o servicio(s) prestado(s) ha(n) sido recibido(s).</td></tr>
        </table>
        {% if cedible %}
            <table style="width: 100%;"><tr><td class="cedible" align="right">{{ enc.IdDoc.TipoDTE in [52, 56, 61, '52', '56', '61'] ? 'CEDIBLE CON SU FACTURA' : 'CEDIBLE' }}</td></tr></table>
        {% endif %}
    {% endif %}
</div>

</body>
</html>
